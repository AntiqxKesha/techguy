# Токен бота — получить у @BotFather в Telegram
BOT_TOKEN=123456789:подставь-свой-токен

# Твой Telegram user id — узнать у @userinfobot
ALLOWED_USER_ID=123456789

# Базовая папка для репозиториев (по умолчанию ~/TechGuy)
# BASE_DIR=~/TechGuy

# Куда складывать загрузки и нарезанные клипы (по умолчанию ~/Downloads)
# DOWNLOADS_DIR=~/Downloads

# Таймаут одной команды в секундах (по умолчанию 3600)
# COMMAND_TIMEOUT=3600

# Длина одной части при команде "нарежь" в секундах (по умолчанию 5400 = 90 мин)
# CHUNK_SECONDS=5400

# Локальный Bot API сервер — нужен, чтобы бот слал видео больше 50 МБ (до 2 ГБ).
# 1. Ключи: my.telegram.org -> API development tools -> создать app
# 2. Запуск сервера:
#    docker run -d --name tg-bot-api --restart unless-stopped -p 127.0.0.1:8081:8081 \
#      -e TELEGRAM_API_ID=твой-id -e TELEGRAM_API_HASH=твой-hash -e TELEGRAM_LOCAL=1 \
#      aiogram/telegram-bot-api:latest
# 3. Раскомментируй и впиши те же значения сюда:
# TELEGRAM_API_ID=12345678
# TELEGRAM_API_HASH=abcdef1234567890abcdef1234567890
