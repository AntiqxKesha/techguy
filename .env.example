# Токен бота — получить у @BotFather в Telegram
BOT_TOKEN=123456789:подставь-свой-токен

# Твой Telegram user id — узнать у @userinfobot
ALLOWED_USER_ID=123456789

# Базовая папка для репозиториев (по умолчанию ~/TechGuy)
# BASE_DIR=~/TechGuy

# Куда складывать загрузки и нарезанные клипы (по умолчанию ~/Downloads)
# DOWNLOADS_DIR=~/Downloads

# Таймаут одной команды в секундах (по умолчанию 7200 = 2 часа)
# COMMAND_TIMEOUT=7200

# Длина одной части при команде "нарежь" в секундах (по умолчанию 5400 = 90 мин)
# CHUNK_SECONDS=5400

# Видео короче этого порога (сек, по умолчанию 21600 = 6 ч) скачивается целиком
# через aria2 в 16 потоков, а части режутся локально. Длинные видео (суточные
# стримы) качаются кусками по месту — медленнее, но без гигантских файлов.
# FULL_DOWNLOAD_MAX_SECONDS=21600

# Cookies браузера для YouTube (лечит "Sign in to confirm you're not a bot").
# Брать из браузера, где ты залогинен на YouTube: safari, chrome, firefox...
# На macOS может понадобиться: Системные настройки -> Конфиденциальность ->
# Полный доступ к диску -> включить для Терминала.
# YTDLP_COOKIES=safari
